COMPOSE_PROJECT_NAME=kcs-control-plane
APP_ENV=development
BACKEND_RELOAD=false
ENABLE_DEBUG_CONFIG_ENDPOINT=false
ENABLE_ADMIN_ROUTES=false
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_SUPPORT_ARTICLE_BASE_URL=https://kb.example.com/knowledge/view
ELASTIC_VERSION=9.3.3
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601
ELASTICSEARCH_LOCAL_URL=http://elasticsearch:9200
SOURCE_ES_URL=https://your-deployment.example.com:443
SOURCE_ES_API_KEY=<set-me>
SOURCE_ES_INDEX=kb-articles-source-index
# Optional. If omitted, remote analysis publish/pull reuses SOURCE_ES_URL and SOURCE_ES_API_KEY.
REMOTE_ANALYSIS_ES_URL=
REMOTE_ANALYSIS_ES_API_KEY=
REMOTE_ANALYSIS_NORMALIZED_ALIAS=kb-analysis-articles-v1
REMOTE_ANALYSIS_CHUNK_ALIAS=kb-analysis-article-chunks-v1
REMOTE_ANALYSIS_DUPLICATE_EDGE_ALIAS=kb-analysis-duplicate-edges-v1
REMOTE_ANALYSIS_DUPLICATE_CLUSTER_ALIAS=kb-analysis-duplicate-clusters-v1
REMOTE_ANALYSIS_METADATA_INDEX=kb-analysis-sync-state-v1
LOCAL_ANALYSIS_METADATA_INDEX=kb-analysis-local-sync-state-v1
REMOTE_ANALYSIS_PUBLISH_LOCK_SECONDS=1800
REMOTE_ANALYSIS_SYNC_BATCH_SIZE=100
REMOTE_ANALYSIS_HTTP_TIMEOUT_SECONDS=180
EMBEDDINGS_PROVIDER=stub
LOCAL_EMBEDDING_URL=http://local-embeddings:7997/v1/embeddings
LOCAL_EMBEDDING_MODEL=jinaai/jina-embeddings-v3-hf
LOCAL_EMBEDDING_PORT=7997
LOCAL_EMBEDDING_MAX_LENGTH=2048
JINA_EMBEDDING_URL=https://api.jina.ai/v1/embeddings
JINA_API_KEY=<set-me>
JINA_EMBEDDING_MODEL=jina-embeddings-v3
DUPLICATE_EMBEDDING_PROVIDER=local
DUPLICATE_EMBEDDING_TASK=retrieval.passage
RERANKER_PROVIDER=stub
JINA_RERANKER_URL=https://api.jina.ai/v1/rerank
JINA_RERANKER_MODEL=jina-reranker-v2-base-multilingual
DUPLICATE_EMBEDDING_DIMS=1024
LLM_EXPLANATION_PROVIDER=stub
GEMINI_API_KEY=<set-me>
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent
DEEPSEARCH_ENABLED=false
DEEPSEARCH_URL=https://app-api.deepsearch.com/v1/compute
DEEPSEARCH_API_KEY=<set-me>
# Multi-agent editorial supervisor (default OFF; when false no agent behaviour is active).
AGENTS_ENABLED=false
# Reasoning provider for the ReviewerAgent: deterministic (default, offline) or gemini.
AGENT_REASONING_PROVIDER=deterministic
AGENT_EPISODE_INDEX=kcs-kb-agent-episodes-v1
AGENT_DRAFT_INDEX=kcs-kb-agent-drafts-v1
